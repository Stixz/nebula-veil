@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

:root {
  --bg: #0a0a0f;
  --accent: #a78bfa;
  --accent-glow: #67e8f9;
  --text: #e0e0ff;
  --text-muted: #a0a0cc;
  --ghost-opacity: 0.4;
  --growth-speed: 400ms;
  --scale-factor: 1.1;
