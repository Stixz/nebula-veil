  --border-width-2px-2: 2px;
  /*  @label Border Width 2px 2 | @desc Auto-extracted from border-width in selector .theme-card.active.  */
  --top-8px-2: 8px;
  /*  @label Top 8px 2 | @desc Auto-extracted from top in selector .theme-card.active::after.  */
  --right-10px-2: 10px;
  /*  @label Right 10px 2 | @desc Auto-extracted from right in selector .theme-card.active::after.  */
  --font-size-13px-21: 13px;
  /*  @label Font Size 13px 21 | @desc Auto-extracted from font-size in selector .theme-card.active::after.  */
  --opacity-0-9-8: 0.9;
  /*  @label Opacity 0 9 8 | @desc Auto-extracted from opacity in selector .theme-card.active::after.  */
  --gap-5px-2: 5px;
  /*  @label Gap 5px 2 | @desc Auto-extracted from gap in selector .theme-swatch.  */
  --margin-bottom-10px-2: 10px;
  /*  @label Margin Bottom 10px 2 | @desc Auto-extracted from margin-bottom in selector .theme-swatch.  */
  --width-18px-4: 18px;
  /*  @label Width 18px 4 | @desc Auto-extracted from width in selector .theme-swatch span.  */
  --height-18px-4: 18px;
  /*  @label Height 18px 4 | @desc Auto-extracted from height in selector .theme-swatch span.  */
  --font-size-13px-22: 13px;
  /*  @label Font Size 13px 22 | @desc Auto-extracted from font-size in selector .theme-name.  */
  --margin-bottom-3px-2: 3px;
  /*  @label Margin Bottom 3px 2 | @desc Auto-extracted from margin-bottom in selector .theme-name.  */
  --font-size-11px-16: 11px;
  /*  @label Font Size 11px 16 | @desc Auto-extracted from font-size in selector .theme-desc.  */
  --opacity-0-8-6: 0.8;
  /*  @label Opacity 0 8 6 | @desc Auto-extracted from opacity in selector .theme-desc.  */
}

* { box-sizing: border-box; margin:0; padding:0; }

body {
  font-family: 'Inter', system-ui, sans-serif;
  background: transparent;
  color: var(--text);
  overflow: hidden;
  height: var(--height-100vh-3);
}

.app {
  height: var(--height-100vh-4);
  display: flex;
  flex-direction: column;
  background: rgba(10, 10, 15, 0.92);
  backdrop-filter: var(--backdrop-filter-20px-2);
  border-radius: var(--border-radius-16px-10);
  border: 1px solid rgba(167, 139, 250, 0.15);
  box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.5);
  overflow: hidden;
}

.title-bar {
  height: var(--height-44px-2);
  background: rgba(255,255,255,0.03);
  display: flex;
  align-items: center;
  padding: 0 16px;
  -webkit-app-region: drag;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.title { font-weight: 500; font-size: var(--font-size-14px-22); opacity: var(--opacity-0-9-5); }

.window-controls {
  margin-left: auto;
  display: flex;
  gap: var(--gap-8px-9);
  -webkit-app-region: no-drag;
}

.window-controls button {
  width: var(--width-32px-2); height: var(--height-32px-3);
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: var(--font-size-18px-4);
  border-radius: var(--border-radius-6px-5);
  transition: all 300ms cubic-bezier(0.23, 1, 0.32, 1);
}

.window-controls button:hover {
  background: rgba(255,255,255,0.1);
  color: white;
}

#quit-btn:hover {
  background: var(--background-color-ff6b6b-2);
  color: white;
}

#close-btn:hover {
  background: var(--background-color-ff6b6b-3);
  color: white;
}

.main {
  flex: 1;
  display: flex;
  overflow: hidden;
  padding-bottom: var(--padding-bottom-32px-2); /* Account for footer */
  min-height: 0;
  min-width: 0;
}

.sidebar {
  width: var(--width-68px-2);
  background: rgba(15, 15, 25, 0.6);
  backdrop-filter: var(--backdrop-filter-12px-4);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: var(--padding-top-24px-2);
  border-right: 1px solid rgba(255,255,255,0.06);
  transition: width 400ms cubic-bezier(0.23, 1, 0.32, 1);
}

.sidebar:hover { width: var(--width-220px-2); }

.logo {
  font-size: var(--font-size-28px-3);
  margin-bottom: var(--margin-bottom-40px-4);
  filter: drop-shadow(0 0 12px var(--accent));
}

.nav-btn {
  width: 100%;
  padding: 14px 16px;
  background: transparent;
  border: none;
  color: var(--text-muted);
  text-align: left;
  display: flex;
  align-items: center;
  gap: var(--gap-16px-8);
  font-size: var(--font-size-15px-3);
  transition: all 300ms cubic-bezier(0.23, 1, 0.32, 1);
  border-radius: 0 8px 8px 0;
}

.nav-btn:hover {
  background: rgba(167, 139, 250, 0.1);
  color: var(--accent);
  transform: var(--transform-4px-2);
}

.nav-btn.active {
  background: rgba(167, 139, 250, 0.15);
  color: white;
  box-shadow: inset 4px 0 0 var(--accent);
}

.icon { font-size: var(--font-size-20px-3); flex-shrink: 0; }

.label { opacity: 0; white-space: nowrap; transition: var(--transition-300ms); }
.sidebar:hover .label { opacity: 1; }

.content {
  flex: 1;
  padding: var(--padding-32px-2);
  overflow: auto;
  background: transparent;
  min-height: 0;
  min-width: 0;
}

.module {
  width: 100%;
  height: 100%;
  opacity: 0;
  animation: fadeInModule 500ms forwards;
}

.content,
.content *,
.module,
.module * {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.content::-webkit-scrollbar,
.content *::-webkit-scrollbar,
.module::-webkit-scrollbar,
.module *::-webkit-scrollbar {
  width: 0;
  height: 0;
}

@keyframes fadeInModule {
  to { opacity: 1; }
}

/* Notepad specific */
.notepad {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.notepad textarea {
  flex: 1;
  background: rgba(15, 15, 25, 0.75);
  border: 1px solid rgba(167, 139, 250, 0.2);
  border-radius: var(--border-radius-12px-7);
  padding: var(--padding-20px-7);
  color: var(--color-color-e0e0ff-14);
  font-size: var(--font-size-15-5px-3);
  line-height: 1.7;
  resize: none;
  transition: all 300ms ease;
  backdrop-filter: var(--backdrop-filter-8px-2);
}

.notepad textarea:focus {
  outline: none;
  border-color: var(--border-color-color-a78bfa-10);
  box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.15);
}

.module-header {
  margin-bottom: var(--margin-bottom-20px-7);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.module-header h2 {
  font-size: var(--font-size-22px-3);
  font-weight: 500;
  color: var(--color-color-c4b5fd-8);
}

.status {
  font-size: var(--font-size-13px-12);
  opacity: var(--opacity-0-7-5);
}

.note-footer {
  margin-top: var(--margin-top-12px-2);
  display: flex;
  justify-content: space-between;
  font-size: var(--font-size-13px-13);
  opacity: var(--opacity-0-8-4);
}

.note-meta {
    background: rgba(167, 139, 250, 0.15);
    color: var(--color-color-a78bfa-7);
    border: none;
    padding: 6px 14px;
    border-radius: var(--border-radius-8px-13);
    display: flex;
    gap: var(--gap-12px-14); /* space between char count and caret position */
    align-items: center;
}

.note-footer button {
  background: rgba(167, 139, 250, 0.15);
  color: var(--color-color-a78bfa-8);
  border: none;
  padding: 6px 14px;
  border-radius: var(--border-radius-8px-14);
  cursor: pointer;
  transition: var(--transition-200ms);
}

.note-footer button:hover {
  background: rgba(167, 139, 250, 0.3);
}

/* Calculator specific */
.calculator {
  width: 100%;
  max-width: var(--max-width-380px-2);
  margin: 0 auto;
  height: auto;
  max-height: 100%;
  overflow: auto;
  box-sizing: border-box;
  background: rgba(15, 15, 25, 0.85);
  border-radius: var(--border-radius-20px-4);
  padding: clamp(14px, 2.2vw, 24px);
  backdrop-filter: var(--backdrop-filter-16px-2);
  border: 1px solid rgba(167, 139, 250, 0.15);
  box-shadow: 0 20px 40px rgba(0,0,0,0.4);
}

.display {
  background: rgba(0,0,0,0.4);
  border-radius: var(--border-radius-16px-11);
  padding: clamp(14px, 2.2vw, 24px) clamp(12px, 2vw, 20px);
  margin-bottom: clamp(14px, 2.2vw, 24px);
  text-align: right;
  min-height: clamp(84px, 12vh, 110px);
  border: 1px solid rgba(103, 232, 249, 0.2);
}

.expression {
  font-size: clamp(13px, 1.7vw, 18px);
  color: var(--color-color-a0a0cc-22);
  min-height: var(--min-height-28px-2);
  margin-bottom: var(--margin-bottom-8px-9);
}

.result {
  font-size: clamp(28px, 4.5vw, 48px);
  font-weight: 500;
  color: white;
  letter-spacing: var(--letter-spacing-neg-1px-2);
}

.keypad {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(8px, 1.2vw, 12px);
}

.key {
  height: clamp(48px, 6.8vh, 68px);
  font-size: clamp(16px, 2.2vw, 22px);
  background: rgba(30, 30, 45, 0.9);
  border: none;
  border-radius: var(--border-radius-14px-3);
  color: var(--color-color-e0e0ff-15);
  transition: all 150ms cubic-bezier(0.23, 1, 0.32, 1);
  box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}

.key:hover {
  background: rgba(167, 139, 250, 0.25);
  transform: var(--transform-neg-2px-6);
}

.key:active {
  transform: var(--transform-0-94-2);
}

.key.operator {
  background: rgba(103, 232, 249, 0.15);
  color: var(--color-color-67e8f9-4);
}

.key.special {
  background: rgba(167, 139, 250, 0.1);
  color: var(--color-color-c4b5fd-9);
}

.key.equals {
  background: var(--background-color-a78bfa-10);
  color: var(--color-color-0a0a0f-9);
  font-weight: 600;
}

.key.zero {
  grid-column: span 2;
}

/* Task Flow */
.tasks {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.task-list {
  flex: 1;
  overflow-y: auto;
  padding-right: var(--padding-right-8px-2);
}

.task-item {
  display: flex;
  align-items: center;
  gap: var(--gap-12px-15);
  padding: 14px 18px;
  background: rgba(20, 20, 35, 0.6);
  border-radius: var(--border-radius-12px-8);
  margin-bottom: var(--margin-bottom-8px-10);
  transition: all 300ms ease;
}

.task-item.done {
  opacity: var(--opacity-0-7-6);
  text-decoration: line-through;
}

.task-item:hover {
  background: rgba(167, 139, 250, 0.1);
}

.task-text {
  flex: 1;
  font-size: var(--font-size-15-5px-4);
  cursor: pointer;
  transition: all 200ms ease;
  border-radius: var(--border-radius-4px-2);
  padding: 2px 4px;
  position: relative;
}

.task-text:hover {
  background: rgba(167,139,250,0.05);
  cursor: pointer;
}

.task-text[contenteditable="true"] {
  background: rgba(167,139,250,0.15);
  outline: none;
  box-shadow: 0 0 0 2px rgba(167,139,250,0.3);
  cursor: text;
}

.delete-task {
  background: none;
  border: none;
  color: var(--color-color-ff6b6b-6);
  font-size: var(--font-size-20px-4);
  cursor: pointer;
  opacity: var(--opacity-0-6-4);
}

.delete-task:hover { opacity: 1; }

.priority-indicator {
  font-weight: bold;
  font-size: var(--font-size-14px-23);
  min-width: var(--min-width-16px-2);
  text-align: center;
}

.priority-high {
  border-left: 3px solid #ff6b6b;
}

.priority-high .priority-indicator {
  color: var(--color-color-ff6b6b-7);
}

.priority-medium {
  border-left: 3px solid #feca57;
}

.priority-medium .priority-indicator {
  color: var(--color-color-feca57-2);
}

.priority-low {
  border-left: 3px solid #48dbfb;
}

.priority-low .priority-indicator {
  color: var(--color-color-48dbfb-2);
}

.task-priority {
  padding: 8px 12px;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: var(--border-radius-6px-6);
  background: rgba(20,20,35,0.6);
  color: var(--color-color-fff-8);
  font-size: var(--font-size-14px-24);
  cursor: pointer;
  transition: var(--transition-200ms-2);
}

.task-priority:hover {
  border-color: rgba(167,139,250,0.5);
  background: rgba(167,139,250,0.1);
}

.task-priority:focus {
  outline: none;
  border-color: var(--border-color-color-a78bfa-11);
  box-shadow: 0 0 0 2px rgba(167,139,250,0.2);
}

.task-priority option {
  background: rgba(20,20,35,0.9);
  color: var(--color-color-fff-9);
  padding: var(--padding-8px-6);
}

.task-due-date {
  padding: 8px 12px;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: var(--border-radius-6px-7);
  background: rgba(20,20,35,0.6);
  color: var(--color-color-fff-10);
  font-size: var(--font-size-14px-25);
  cursor: pointer;
  transition: var(--transition-200ms-3);
}

.task-due-date:hover {
  border-color: rgba(167,139,250,0.5);
  background: rgba(167,139,250,0.1);
}

.task-due-date:focus {
  outline: none;
  border-color: var(--border-color-color-a78bfa-12);
  box-shadow: 0 0 0 2px rgba(167,139,250,0.2);
}

.due-date {
  font-size: var(--font-size-12px-9);
  color: var(--color-color-a0a0cc-23);
  background: rgba(167,139,250,0.1);
  padding: 2px 8px;
  border-radius: var(--border-radius-12px-9);
  margin-left: auto;
  white-space: nowrap;
}

.overdue {
  background: rgba(255,107,107,0.1);
  border-left-color: var(--border-left-color-color-ff6b6b-2);
}

.overdue .due-date {
  color: var(--color-color-ff6b6b-8);
  background: rgba(255,107,107,0.2);
}

.category-tag {
  font-size: var(--font-size-11px-9);
  color: var(--color-color-a0a0cc-24);
  background: rgba(103,232,249,0.1);
  padding: 2px 6px;
  border-radius: var(--border-radius-8px-15);
  margin-left: var(--margin-left-8px-2);
  white-space: nowrap;
}

.header-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--gap-16px-9);
  flex-wrap: wrap;
}

.category-filters {
  display: flex;
  gap: var(--gap-6px-2);
  flex-wrap: wrap;
}

.category-filter {
  padding: 6px 12px;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: var(--border-radius-16px-12);
  background: rgba(20,20,35,0.6);
  color: var(--color-color-a0a0cc-25);
  font-size: var(--font-size-12px-10);
  cursor: pointer;
  transition: var(--transition-200ms-4);
  white-space: nowrap;
}

.category-filter:hover {
  border-color: rgba(167,139,250,0.5);
  background: rgba(167,139,250,0.1);
  color: var(--color-color-c4b5fd-10);
}

.category-filter.active {
  background: var(--background-color-a78bfa-11);
  color: var(--color-color-0a0a0f-10);
  border-color: var(--border-color-color-a78bfa-13);
}

.task-category {
  padding: 8px 12px;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: var(--border-radius-6px-8);
  background: rgba(20,20,35,0.6);
  color: var(--color-color-fff-11);
  font-size: var(--font-size-14px-26);
  cursor: pointer;
  transition: var(--transition-200ms-5);
}

.task-category:hover {
  border-color: rgba(167,139,250,0.5);
  background: rgba(167,139,250,0.1);
}

.task-category:focus {
  outline: none;
  border-color: var(--border-color-color-a78bfa-14);
  box-shadow: 0 0 0 2px rgba(167,139,250,0.2);
}

.task-category option {
  background: rgba(20,20,35,0.9);
  color: var(--color-color-fff-12);
  padding: var(--padding-8px-7);
}

.search-area {
  flex: 1;
  max-width: var(--max-width-300px-2);
}

.task-search {
  width: 100%;
  padding: 8px 12px;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: var(--border-radius-20px-5);
  background: rgba(20,20,35,0.6);
  color: var(--color-color-fff-13);
  font-size: var(--font-size-14px-27);
  transition: var(--transition-200ms-6);
}

.task-search::placeholder {
  color: var(--color-color-a0a0cc-26);
}

.task-search:hover {
  border-color: rgba(167,139,250,0.5);
  background: rgba(167,139,250,0.1);
}

.task-search:focus {
  outline: none;
  border-color: var(--border-color-color-a78bfa-15);
  box-shadow: 0 0 0 2px rgba(167,139,250,0.2);
}

.task-input-area {
  display: flex;
  gap: var(--gap-8px-10);
  margin-top: var(--margin-top-16px-2);
}

.task-input-area input {
  flex: 1;
  background: rgba(15,15,25,0.8);
  border: 1px solid rgba(167,139,250,0.2);
  border-radius: var(--border-radius-10px-4);
  padding: 14px 16px;
  color: white;
  font-size: var(--font-size-15px-4);
}

.add-confirm, .add-btn {
  background: var(--background-color-a78bfa-12);
  color: var(--color-color-0a0a0f-11);
  border: none;
  padding: 0 20px;
  border-radius: var(--border-radius-10px-5);
  font-weight: 600;
  cursor: pointer;
}

/* Focus Timer */
.timer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  text-align: center;
}

.timer-display {
  margin-bottom: var(--margin-bottom-40px-5);
}

.countdown {
  font-size: var(--font-size-92px-2);
  font-weight: 500;
  letter-spacing: var(--letter-spacing-neg-4px-2);
  color: var(--color-color-e0e0ff-16);
  text-shadow: 0 0 30px rgba(167, 139, 250, 0.4);
}

.status {
  font-size: var(--font-size-18px-5);
  opacity: var(--opacity-0-8-5);
  margin-top: var(--margin-top-8px-2);
}

.timer-controls {
  display: flex;
  gap: var(--gap-16px-10);
  margin-bottom: var(--margin-bottom-40px-6);
}

.timer-btn {
  padding: 14px 32px;
  font-size: var(--font-size-16px-5);
  background: rgba(30,30,45,0.9);
  border: 1px solid rgba(167,139,250,0.3);
  border-radius: var(--border-radius-50px-2);
  color: white;
  cursor: pointer;
  transition: all 300ms ease;
}

.timer-btn:hover {
  background: rgba(167,139,250,0.2);
  transform: var(--transform-neg-2px-7);
}

.timer-modes {
  display: flex;
  gap: var(--gap-12px-16);
}

.mode-btn {
  padding: 10px 24px;
  background: rgba(20,20,35,0.7);
  border: none;
  border-radius: var(--border-radius-30px-2);
  color: var(--color-color-a0a0cc-27);
  font-size: var(--font-size-14px-28);
  cursor: pointer;
  transition: var(--transition-300ms-2);
}

.mode-btn.active,
.mode-btn:hover {
  background: var(--background-color-a78bfa-13);
  color: var(--color-color-0a0a0f-12);
}

.timer-modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: var(--gap-12px-17);
  padding: 20px 24px;
  border-top: 1px solid rgba(255,255,255,0.1);
}

.modal-btn {
  padding: 8px 16px;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: var(--border-radius-10px-6);
  font-size: var(--font-size-14px-29);
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition-200ms-7);
  background: rgba(20,20,35,0.6);
  color: var(--color-color-fff-14);
}

.modal-btn.cancel {
  background: rgba(20,20,35,0.8);
  border-color: rgba(255,255,255,0.2);
  color: var(--color-color-a0a0cc-28);
}

.modal-btn.cancel:hover {
  border-color: rgba(167,139,250,0.5);
  background: rgba(167,139,250,0.1);
  color: var(--color-color-c4b5fd-11);
  transform: var(--transform-neg-1px-4);
}

.modal-btn.save {
  background: var(--background-color-a78bfa-14);
  color: var(--color-color-0a0a0f-13);
  border-color: var(--border-color-color-a78bfa-16);
  font-weight: 600;
}

.modal-btn.save:hover {
  background: var(--background-color-8b5cf6-2);
  border-color: var(--border-color-color-8b5cf6-2);
  transform: var(--transform-neg-1px-5);
  box-shadow: 0 4px 12px rgba(167,139,250,0.3);
}

/* About Modal Styles */
.about-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-content {
  text-align: center;
  padding: 20px 0;
}

.app-logo {
  font-size: var(--font-size-32px-2);
  font-weight: 700;
  color: var(--color-color-a78bfa-9);
  margin-bottom: var(--margin-bottom-8px-11);
  text-shadow: 0 0 20px rgba(167,139,250,0.5);
}

.app-version {
  font-size: var(--font-size-14px-30);
  color: var(--color-color-a0a0cc-29);
  margin-bottom: var(--margin-bottom-20px-8);
  text-transform: uppercase;
  letter-spacing: var(--letter-spacing-1px-7);
}

.app-description {
  font-size: var(--font-size-16px-6);
  line-height: 1.6;
  color: var(--color-color-e0e0ff-17);
  margin-bottom: var(--margin-bottom-30px-3);
  max-width: var(--max-width-400px-4);
  margin-left: auto;
  margin-right: auto;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--gap-16px-11);
  margin-bottom: var(--margin-bottom-30px-4);
  max-width: var(--max-width-400px-5);
  margin-left: auto;
  margin-right: auto;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: var(--gap-8px-11);
  padding: var(--padding-12px-3);
  background: rgba(167,139,250,0.1);
  border-radius: var(--border-radius-8px-16);
  border: 1px solid rgba(167,139,250,0.2);
  transition: var(--transition-200ms-8);
}

.feature-item:hover {
  background: rgba(167,139,250,0.15);
  transform: var(--transform-neg-2px-8);
}

.feature-icon {
  font-size: var(--font-size-18px-6);
  color: var(--color-color-a78bfa-10);
}

.feature-text {
  font-size: var(--font-size-14px-31);
  color: var(--color-color-e0e0ff-18);
  font-weight: 500;
}

.credits {
  border-top: 1px solid rgba(255,255,255,0.1);
  padding-top: var(--padding-top-20px-2);
  margin-top: var(--margin-top-20px-3);
}

.credits p {
  font-size: var(--font-size-13px-14);
  color: var(--color-color-a0a0cc-30);
  margin-bottom: var(--margin-bottom-8px-12);
  line-height: 1.4;
}

.credits strong {
  color: var(--color-color-c4b5fd-12);
}

.modal-btn.close {
  background: rgba(20,20,35,0.8);
  border-color: rgba(255,255,255,0.2);
  color: var(--color-color-a0a0cc-31);
}

.modal-btn.close:hover {
  border-color: rgba(167,139,250,0.5);
  background: rgba(167,139,250,0.1);
  color: var(--color-color-c4b5fd-13);
  transform: var(--transform-neg-1px-6);
}

/* System Stats */
.system-stats {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--gap-16px-12);
  margin-bottom: var(--margin-bottom-24px-3);
}

.stat-card {
  background: rgba(20, 20, 35, 0.7);
  border-radius: var(--border-radius-16px-13);
  padding: var(--padding-20px-8);
  border: 1px solid rgba(255,255,255,0.08);
  transition: all 300ms ease;
}

.stat-card:hover {
  background: rgba(30, 30, 50, 0.8);
  transform: var(--transform-neg-2px-9);
}

.stat-icon { font-size: var(--font-size-28px-4); margin-bottom: var(--margin-bottom-8px-13); }
.stat-label { font-size: var(--font-size-13px-15); color: var(--color-color-a0a0cc-32); margin-bottom: var(--margin-bottom-4px-5); text-transform: uppercase; letter-spacing: var(--letter-spacing-1px-8); }
.stat-value { font-size: var(--font-size-22px-4); font-weight: 500; margin-bottom: var(--margin-bottom-12px-2); }

.stat-bar {
  height: var(--height-6px-3);
  background: rgba(255,255,255,0.1);
  border-radius: var(--border-radius-3px-4);
  overflow: hidden;
}

.stat-fill {
  height: 100%;
  border-radius: var(--border-radius-3px-5);
  transition: width 500ms ease, background 300ms ease;
  background: var(--background-color-67e8f9-2);
}

.processes-section {
  flex: 1;
  background: rgba(20, 20, 35, 0.6);
  border-radius: var(--border-radius-16px-14);
  padding: var(--padding-20px-9);
  overflow: auto;
}

.processes-section h3 {
  font-size: var(--font-size-14px-32);
  font-weight: 500;
  color: var(--color-color-a0a0cc-33);
  margin-bottom: var(--margin-bottom-16px-4);
  text-transform: uppercase;
  letter-spacing: var(--letter-spacing-1px-9);
}

.process-header {
  display: grid;
  grid-template-columns: 1fr 80px 100px;
  gap: var(--gap-12px-18);
  padding: 8px 12px;
  font-size: var(--font-size-12px-11);
  color: var(--color-color-666-4);
  text-transform: uppercase;
  letter-spacing: var(--letter-spacing-1px-10);
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.process-item {
  display: grid;
  grid-template-columns: 1fr 80px 100px;
  gap: var(--gap-12px-19);
  padding: 10px 12px;
  font-size: var(--font-size-13px-16);
  border-radius: var(--border-radius-8px-17);
  transition: var(--transition-200ms-9);
}

.process-item:hover { background: rgba(167, 139, 250, 0.1); }
.process-name { color: var(--color-color-e0e0ff-19); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.process-cpu, .process-mem { color: var(--color-color-a0a0cc-34); }

.refresh-info { font-size: var(--font-size-12px-12); color: var(--color-color-666-5); }

/* Focus Music */
.focus-music {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.now-playing {
  font-size: var(--font-size-13px-17);
  color: var(--color-color-67e8f9-5);
  opacity: var(--opacity-0-9-6);
}

.sound-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--gap-16px-13);
  margin: 24px 0;
}

.sound-card {
  background: rgba(20, 20, 35, 0.7);
  border-radius: var(--border-radius-16px-15);
  padding: 24px 16px;
  text-align: center;
  cursor: pointer;
  border: 2px solid transparent;
  transition: all 300ms cubic-bezier(0.23, 1, 0.32, 1);
}

.sound-card:hover {
  background: rgba(30, 30, 50, 0.8);
  transform: var(--transform-neg-4px-2);
  box-shadow: 0 8px 20px rgba(0,0,0,0.3);
}

.sound-card.active {
  border-color: var(--border-color-color-a78bfa-17);
  background: rgba(167, 139, 250, 0.15);
}

.sound-icon { font-size: var(--font-size-36px-2); margin-bottom: var(--margin-bottom-8px-14); }
.sound-name { font-size: var(--font-size-14px-33); color: var(--color-color-e0e0ff-20); font-weight: 500; }

.player-controls {
  display: flex;
  align-items: center;
  gap: var(--gap-16px-14);
  padding: var(--padding-20px-10);
  background: rgba(20, 20, 35, 0.6);
  border-radius: var(--border-radius-16px-16);
  margin-bottom: var(--margin-bottom-24px-4);
}

.player-btn {
  padding: 12px 24px;
  border-radius: var(--border-radius-25px-2);
  border: none;
  background: var(--background-color-a78bfa-15);
  color: var(--color-color-0a0a0f-14);
  font-size: var(--font-size-14px-34);
  cursor: pointer;
  transition: var(--transition-200ms-10);
}

.player-btn:hover { background: var(--background-color-c4b5fd-3); transform: var(--transform-neg-2px-10); }

.volume-control {
  display: flex;
  align-items: center;
  gap: var(--gap-12px-20);
  flex: 1;
  color: var(--color-color-a0a0cc-35);
}

.volume-control input[type="range"] {
  flex: 1;
  height: var(--height-6px-4);
  border-radius: var(--border-radius-3px-6);
  background: rgba(255,255,255,0.1);
  appearance: none;
  cursor: pointer;
}

.volume-control input[type="range"]::-webkit-slider-thumb {
  appearance: none;
  width: var(--width-18px-3); height: var(--height-18px-3);
  border-radius: 50%;
  background: var(--background-color-a78bfa-16);
  cursor: pointer;
}

.mixer-section {
  background: rgba(20, 20, 35, 0.5);
  border-radius: var(--border-radius-16px-17);
  padding: var(--padding-20px-11);
}

.mixer-section h3 {
  font-size: var(--font-size-14px-35);
  font-weight: 500;
  color: var(--color-color-a0a0cc-36);
  margin-bottom: var(--margin-bottom-4px-6);
}

.mixer-info { font-size: var(--font-size-12px-13); color: var(--color-color-666-6); margin-bottom: var(--margin-bottom-16px-5); }

.active-mixer {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap-8px-12);
}

.mixer-item {
  display: flex;
  align-items: center;
  gap: var(--gap-8px-13);
  padding: 8px 12px;
  background: rgba(167, 139, 250, 0.2);
  border-radius: var(--border-radius-20px-6);
  font-size: var(--font-size-13px-18);
  color: var(--color-color-e0e0ff-21);
}

.mixer-remove {
  background: none;
  border: none;
  color: var(--color-color-ff6b6b-9);
  cursor: pointer;
  font-size: var(--font-size-16px-7);
  padding: 0;
  line-height: 1;
}

.mixer-remove:hover { color: var(--color-color-ff4444-2); }

/* Calendar Module */
.calendar {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--margin-bottom-20px-9);
  flex-wrap: wrap;
  gap: var(--gap-12px-21);
}

.cal-nav {
  display: flex;
  gap: var(--gap-8px-14);
  align-items: center;
}

.cal-title {
  font-size: var(--font-size-1-4rem-2);
  font-weight: 500;
  color: var(--color-color-c4b5fd-14);
  margin: 0;
  min-width: var(--min-width-180px-2);
  text-align: center;
}

.calendar-actions {
  display: flex;
  gap: var(--gap-12px-22);
  align-items: center;
}

.cal-btn {
  padding: 8px 14px;
  background: rgba(167, 139, 250, 0.15);
  border: 1px solid rgba(167, 139, 250, 0.3);
  border-radius: var(--border-radius-8px-18);
  color: var(--color-color-e0e0ff-22);
  cursor: pointer;
  font-size: var(--font-size-14px-36);
  transition: var(--transition-200ms-11);
}

.cal-btn:hover {
  background: rgba(167, 139, 250, 0.25);
}

.cal-btn-primary {
  padding: 8px 16px;
  background: var(--background-color-a78bfa-17);
  border: none;
  border-radius: var(--border-radius-8px-19);
  color: var(--color-color-0a0a0f-15);
  cursor: pointer;
  font-size: var(--font-size-14px-37);
  font-weight: 600;
  transition: var(--transition-200ms-12);
}

.cal-btn-primary:hover {
  background: var(--background-color-c4b5fd-4);
}

.cal-btn-danger {
  padding: 8px 16px;
  background: var(--background-color-ff6b6b-4);
  border: none;
  border-radius: var(--border-radius-8px-20);
  color: white;
  cursor: pointer;
  font-size: var(--font-size-14px-38);
}

.cal-btn-danger:hover {
  background: var(--background-color-ff4444-2);
}

.cal-view-toggle {
  display: flex;
  background: rgba(15, 15, 25, 0.5);
  border-radius: var(--border-radius-8px-21);
  overflow: hidden;
}

.cal-view-btn {
  padding: 8px 16px;
  background: transparent;
  border: none;
  color: var(--color-color-a0a0cc-37);
  cursor: pointer;
  font-size: var(--font-size-13px-19);
  transition: var(--transition-200ms-13);
}

.cal-view-btn.active {
  background: var(--background-color-a78bfa-18);
  color: var(--color-color-0a0a0f-16);
}

.cal-view-btn:hover:not(.active) {
  background: rgba(167, 139, 250, 0.2);
}

.calendar-grid-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: var(--font-size-12px-14);
  color: var(--color-color-a0a0cc-38);
  text-transform: uppercase;
  letter-spacing: var(--letter-spacing-1px-11);
  margin-bottom: var(--margin-bottom-8px-15);
  padding-bottom: var(--padding-bottom-8px-2);
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: var(--gap-4px-3);
  flex: 1;
  overflow-y: auto;
}

.cal-day {
  background: rgba(20, 20, 35, 0.6);
  border-radius: var(--border-radius-8px-22);
  padding: var(--padding-8px-8);
  min-height: var(--min-height-80px-2);
  cursor: pointer;
  transition: var(--transition-200ms-14);
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.cal-day:hover {
  background: rgba(30, 30, 50, 0.8);
}

.cal-day.other-month {
  opacity: var(--opacity-0-3-2);
}

.cal-day.today {
  border: 2px solid #67e8f9;
}

.cal-day.selected {
  background: rgba(167, 139, 250, 0.2);
  outline: 2px solid #a78bfa;
}

.cal-day-num {
  font-size: var(--font-size-14px-39);
  font-weight: 500;
  color: var(--color-color-e0e0ff-23);
  margin-bottom: var(--margin-bottom-4px-7);
}

.cal-day-events {
  flex: 1;
  width: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 0;
  min-width: 0;
}

.cal-event {
  background: rgba(167, 139, 250, 0.3);
  border-left: 3px solid #a78bfa;
  padding: 2px 6px;
  font-size: var(--font-size-11px-10);
  margin-bottom: var(--margin-bottom-2px-2);
  border-radius: 0 4px 4px 0;
  width: 100%;
  max-width: none;
  box-sizing: border-box;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--color-color-e0e0ff-24);
}

.cal-event.completed {
  opacity: var(--opacity-0-5-3);
  text-decoration: line-through;
}

.cal-event-time {
  opacity: var(--opacity-0-7-7);
}

.cal-more {
  font-size: var(--font-size-10px-3);
  color: var(--color-color-a0a0cc-39);
  text-align: center;
}

/* Modal */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: var(--backdrop-filter-4px-2);
}

.modal-content {
  background: rgba(20, 20, 35, 0.98);
  border: 1px solid rgba(167, 139, 250, 0.3);
  border-radius: var(--border-radius-16px-18);
  padding: var(--padding-24px-2);
  width: 90%;
  max-width: var(--max-width-400px-6);
  box-shadow: 0 20px 40px rgba(0,0,0,0.5);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--margin-bottom-20px-10);
}

.modal-header h3 {
  margin: 0;
  color: var(--color-color-a78bfa-11);
}

.modal-close {
  background: none;
  border: none;
  color: var(--color-color-a0a0cc-40);
  font-size: var(--font-size-24px-2);
  cursor: pointer;
  line-height: 1;
}

.modal-close:hover {
  color: var(--color-color-ff6b6b-10);
}

.form-group {
  margin-bottom: var(--margin-bottom-16px-6);
}

.form-group label {
  display: block;
  font-size: var(--font-size-12px-15);
  color: var(--color-color-a0a0cc-41);
  margin-bottom: var(--margin-bottom-6px-2);
  text-transform: uppercase;
  letter-spacing: var(--letter-spacing-1px-12);
}

.form-group input,
.form-group textarea {
  width: 100%;
  background: rgba(15, 15, 25, 0.8);
  border: 1px solid rgba(167, 139, 250, 0.2);
  border-radius: var(--border-radius-8px-23);
  padding: 10px 12px;
  color: var(--color-color-e0e0ff-25);
  font-size: var(--font-size-14px-40);
  font-family: inherit;
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--border-color-color-a78bfa-18);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--gap-12px-23);
}

.form-actions {
  display: flex;
  gap: var(--gap-12px-24);
  justify-content: flex-end;
  margin-top: var(--margin-top-20px-4);
}

.form-actions .cal-btn-danger {
  margin-right: auto;
}

/* Day Detail Panel */
.day-detail {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: var(--width-320px-2);
  background: rgba(20, 20, 35, 0.98);
  border-left: 1px solid rgba(167, 139, 250, 0.2);
  padding: var(--padding-20px-12);
  z-index: 100;
  overflow-y: auto;
  box-shadow: -10px 0 30px rgba(0,0,0,0.3);
}

.day-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--margin-bottom-20px-11);
}

.day-detail-header h3 {
  margin: 0;
  font-size: var(--font-size-1rem-2);
  color: var(--color-color-a78bfa-12);
  line-height: 1.3;
}

.day-events-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-12px-25);
}

.day-event-item {
  background: rgba(30, 30, 50, 0.6);
  border-radius: var(--border-radius-12px-10);
  padding: var(--padding-14px-2);
  cursor: pointer;
  transition: var(--transition-200ms-15);
  border-left: 3px solid #a78bfa;
}

.day-event-item:hover {
  background: rgba(167, 139, 250, 0.15);
}

.day-event-item.completed {
  opacity: var(--opacity-0-6-5);
}

.day-event-time {
  font-size: var(--font-size-11px-11);
  color: var(--color-color-67e8f9-6);
  margin-bottom: var(--margin-bottom-4px-8);
}

.day-event-title {
  font-size: var(--font-size-14px-41);
  font-weight: 500;
  color: var(--color-color-e0e0ff-26);
}

.day-event-location,
.day-event-notes {
  font-size: var(--font-size-12px-16);
  color: var(--color-color-a0a0cc-42);
  margin-top: var(--margin-top-6px-2);
}

/* Footer Styles */
.app-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: var(--height-32px-4);
  background: rgba(10, 10, 15, 0.8);
  backdrop-filter: var(--backdrop-filter-12px-5);
  border-top: 1px solid rgba(167, 139, 250, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.footer-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.copyright {
  font-size: var(--font-size-11px-12);
  color: var(--text-muted);
  font-weight: 400;
  opacity: var(--opacity-0-7-8);
  letter-spacing: var(--letter-spacing-0-5px-3);
}

.app-footer:hover .copyright {
  opacity: var(--opacity-0-9-7);
  color: var(--text);
}

/* Week View Styles */
.week-view {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: var(--gap-8px-15);
  height: 100%;
  padding: var(--padding-8px-9);
}

.week-day {
  background: rgba(15, 15, 25, 0.6);
  border: 1px solid rgba(167, 139, 250, 0.1);
  border-radius: var(--border-radius-12px-11);
  padding: var(--padding-12px-4);
  cursor: pointer;
  transition: var(--transition-200ms-16);
  display: flex;
  flex-direction: column;
  min-height: var(--min-height-120px-2);
}

.week-day:hover {
  background: rgba(167, 139, 250, 0.1);
  border-color: rgba(167, 139, 250, 0.3);
}

.week-day.today {
  background: rgba(167, 139, 250, 0.15);
  border-color: var(--accent);
}

.week-day.selected {
  background: rgba(167, 139, 250, 0.2);
  outline: 2px solid var(--accent);
}

.week-day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--margin-bottom-8px-16);
  padding-bottom: var(--padding-bottom-6px-2);
  border-bottom: 1px solid rgba(167, 139, 250, 0.1);
}

.week-day-name {
  font-size: var(--font-size-11px-13);
  color: var(--text-muted);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: var(--letter-spacing-0-5px-4);
}

.week-day-num {
  font-size: var(--font-size-16px-8);
  font-weight: 600;
  color: var(--text);
}

.week-day-events {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: var(--gap-4px-4);
}

.week-event {
  background: rgba(167, 139, 250, 0.2);
  border-left: 3px solid var(--accent);
  padding: 4px 6px;
  font-size: var(--font-size-11px-14);
  border-radius: 0 4px 4px 0;
  cursor: pointer;
  transition: var(--transition-200ms-17);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.week-event:hover {
  background: rgba(167, 139, 250, 0.3);
}

.week-event.completed {
  opacity: var(--opacity-0-5-4);
  text-decoration: line-through;
}

.week-event-time {
  color: var(--accent-glow);
  font-size: var(--font-size-10px-4);
  margin-right: var(--margin-right-4px-2);
}

.week-event-title {
  color: var(--text);
}

.no-events {
  color: var(--text-muted);
  font-size: var(--font-size-11px-15);
  opacity: var(--opacity-0-6-6);
  font-style: italic;
  text-align: center;
  padding: 8px 0;
}

/* Context Menu Styles */
.context-menu {
  position: fixed;
  background: rgba(20, 20, 35, 0.98);
  border: 1px solid rgba(167, 139, 250, 0.3);
  border-radius: var(--border-radius-12px-12);
  padding: var(--padding-8px-10);
  min-width: var(--min-width-160px-2);
  z-index: 2000;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  backdrop-filter: var(--backdrop-filter-12px-6);
}

.context-menu-item {
  padding: 10px 16px;
  color: var(--text);
  cursor: pointer;
  border-radius: var(--border-radius-8px-24);
  transition: var(--transition-200ms-18);
  font-size: var(--font-size-14px-42);
  display: flex;
  align-items: center;
  gap: var(--gap-8px-16);
}

.context-menu-item:hover {
  background: rgba(167, 139, 250, 0.2);
  color: var(--accent);
}

.context-menu-item:first-child {
  color: var(--accent);
  font-weight: 500;
}

/* ── Theme Picker ─────────────────────────────────────────── */
.theme-modal-content {
  max-width: var(--max-width-480px-2);
}

.theme-subtitle {
  font-size: var(--font-size-13px-20);
  color: var(--text-muted);
  margin-bottom: var(--margin-bottom-20px-12);
  text-align: center;
}

.theme-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--gap-12px-26);
}

.theme-card {
  background: rgba(20, 20, 35, 0.6);
  border: 2px solid rgba(255,255,255,0.08);
  border-radius: var(--border-radius-14px-4);
  padding: 16px 12px;
  cursor: pointer;
  transition: all 250ms cubic-bezier(0.23, 1, 0.32, 1);
  text-align: center;
  position: relative;
  overflow: hidden;
}

.theme-card:hover {
  transform: var(--transform-neg-3px-2);
  border-color: rgba(255,255,255,0.2);
  box-shadow: 0 8px 20px rgba(0,0,0,0.35);
}

.theme-card.active {
  border-width: var(--border-width-2px-2);
  box-shadow: 0 0 0 1px rgba(255,255,255,0.15), 0 8px 24px rgba(0,0,0,0.4);
}

.theme-card.active::after {
  content: '✓';
  position: absolute;
  top: var(--top-8px-2);
  right: var(--right-10px-2);
  font-size: var(--font-size-13px-21);
  font-weight: 700;
  color: white;
  opacity: var(--opacity-0-9-8);
}

.theme-swatch {
  display: flex;
  gap: var(--gap-5px-2);
  justify-content: center;
  margin-bottom: var(--margin-bottom-10px-2);
}

.theme-swatch span {
  width: var(--width-18px-4);
  height: var(--height-18px-4);
  border-radius: 50%;
  display: inline-block;
  box-shadow: 0 2px 6px rgba(0,0,0,0.4);
}

.theme-name {
  font-size: var(--font-size-13px-22);
  font-weight: 600;
  color: var(--text);
  margin-bottom: var(--margin-bottom-3px-2);
}

.theme-desc {
  font-size: var(--font-size-11px-16);
  color: var(--text-muted);
  opacity: var(--opacity-0-8-6);
}

